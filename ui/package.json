{
    "proxy": "http://localhost:5433",
    "name": "ui",
    "version": "0.1.0",
    "private": true,
    "dependencies": {
        "@aws-amplify/ui-react": "^4.6.0",
        "@emotion/react": "^11.9.3",
        "@emotion/styled": "^11.9.3",
        "@fontsource/roboto": "^5.0.3",
        "@leenguyen/react-flip-clock-countdown": "^1.4.0",
        "@mui/icons-material": "^5.8.4",
        "@mui/material": "^5.9.0",
        "@pqina/flip": "^1.7.7",
        "@testing-library/jest-dom": "^5.16.4",
        "@testing-library/react": "^13.3.0",
        "@testing-library/user-event": "^13.5.0",
        "@visx/xychart": "^3.1.2",
        "aws-amplify": "^5.1.4",
        "graphql-ws": "^5.16.0",
        "localforage": "^1.10.0",
        "match-sorter": "^6.3.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-relay": "^14.1.0",
        "react-router-dom": "^6.13.0",
        "react-scripts": "5.0.1",
        "react-spring": "^9.7.1",
        "recharts": "^2.13.3",
        "relay-runtime": "^14.1.0",
        "sort-by": "^1.2.0",
        "web-vitals": "^2.1.4"
    },
    "scripts": {
        "start": "npm run relay && react-scripts start",
        "build": "npm run relay && react-scripts build",
        "test": "react-scripts test",
        "eject": "react-scripts eject",
        "relay": "relay-compiler"
    },
    "relay": {
        "src": "./src/",
        "schema": "./schema.graphql",
        "language": "javascript",
        "excludes": [
            "src/components/views/tourney/playerstats/**",
            "src/components/views/tourney/scoregraph/**",
            "src/components/views/leaderboard/**",
            "src/components/views/stats/**"
        ],
        "schemaConfig": {
            "nodeInterfaceIdField": "nodeId"
        }
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "babel-plugin-relay": "^14.1.0",
        "relay-compiler": "^14.1.0"
    }
}
